@model DashboardViewModel
@{ViewData["Title"]="Dashboard";}<div class="container py-5">
<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<span class="eyebrow">YOUR WORKSPACE</span>
<h1 class="display-6">Welcome, @Model.Name</h1>
</div>
<form method="post" action="/dashboard/create">
<button class="btn btn-primary btn-lg">+ Create meeting</button>
</form>
</div>@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}<div class="join-card">
<div>
<h4>Join an existing meeting</h4>
<p class="mb-0 text-secondary">Enter the six-character room code.</p>
</div>
<form class="d-flex gap-2" onsubmit="this.action='/join/'+this.roomCode.value">
<input name="roomCode" class="form-control form-control-lg text-uppercase" maxlength="6" placeholder="ABC123" required>
<button class="btn btn-dark px-4">Join</button>
</form>
</div>
<h3 class="mt-5 mb-3">Recent meetings</h3>
<div class="table-responsive card border-0 shadow-sm">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>Room</th>
<th>Date</th>
<th>Duration</th>
<th>Participants</th>
<th>
</th>
</tr>
</thead>
<tbody>@if(!Model.Meetings.Any()){<tr>
<td colspan="5" class="empty">No meetings yet. Create your first room.</td>
</tr>}@foreach(var m in Model.Meetings){var duration=m.StartedAt.HasValue?(m.EndedAt??DateTime.UtcNow)-m.StartedAt.Value:TimeSpan.Zero;<tr>
<td>
<b>@m.RoomCode</b>
</td>
<td>@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</td>
<td>@((int)duration.TotalMinutes) min</td>
<td>@m.ParticipantCount</td>
<td>
<a href="/transcripts/@m.Id">View transcript &rarr;</a>
</td>
</tr>}</tbody>
</table>
</div>
</div>
