<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>@ViewData["Title"] - LinguaMeet</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark lm-nav">
<div class="container">
<a class="navbar-brand fw-bold" href="/">Lingua<span>Meet</span>
</a>
<div class="ms-auto d-flex gap-2">@if(Context.Session.GetString("Token")!=null){<a class="btn btn-sm btn-outline-light" href="/dashboard">Dashboard</a>
<form method="post" action="/auth/logout">
<button class="btn btn-sm btn-light">Logout</button>
</form>}else{<a class="btn btn-sm btn-outline-light" href="/auth/login">Login</a>
<a class="btn btn-sm btn-light" href="/auth/register">Create account</a>}</div>
</div>
</nav>
<main>@RenderBody()</main>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
</script>@await RenderSectionAsync("Scripts",false)</body>
</html>
